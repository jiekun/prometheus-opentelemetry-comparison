receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:
    send_batch_size: 10000
    timeout: 1s

extensions:
  file_storage:
    directory: /home/jiekun/prometheus-opentelemetry-comparison/bin/otel-agent-storage

exporters:
  # cmd/metrics-noop-receiver (deployment/docker/backend), running on the
  # same instance as the real Prometheus server (10.140.15.201) but on its
  # own ports. Its OTLP endpoint is gRPC-only for our purposes: the gRPC
  # side (:8001) is a standard, fully-compliant OTLP MetricsService, while
  # its HTTP side (:8000/otlp/export) never decompresses the request body
  # before unmarshaling - it would just count every batch as a decode
  # error if this exporter used HTTP with compression enabled.
  otlp/noop-receiver:
    sending_queue:
      storage: file_storage
    endpoint: "10.140.15.201:8001"
    compression: gzip
    timeout: 10s
    tls:
      insecure: true

service:
  extensions: [file_storage]
  pipelines:
    metrics:
      receivers: [ otlp ]
      processors: [ batch ]
      exporters: [ otlp/noop-receiver ]

  # Self-observability: exposes the collector's own internal metrics as a
  # Prometheus-scrapeable endpoint (see prometheus-server's prometheus.yaml
  # for the matching scrape job). In particular this includes
  # otelcol_receiver_accepted_metric_points - the sample count this agent
  # has actually received from otel-app - alongside its own resource usage
  # (otelcol_process_*). without_type_suffix defaults to true for this
  # exporter, so the accepted-points counter is exposed without a
  # trailing _total.
  telemetry:
    metrics:
      level: basic
      readers:
        - pull:
            exporter:
              prometheus:
                host: "0.0.0.0"
                port: 8888

